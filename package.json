{
  "name": "stateid-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon -q --watch src src/server.js",
    "smoke": "powershell -File scripts/smoke.ps1",
    "test": "node --test test/*.test.js",
    "test:local": "powershell -File scripts/test.ps1",
    "edge:test": "tsx --test test/edge/**/*.mts",
    "edge:dev": "wrangler dev",
    "edge:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "nodemon": "^3.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.34.0"
  }
}
