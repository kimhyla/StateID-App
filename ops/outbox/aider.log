      const abs = link.startsWith('http') ? link : (location.origin + link);
      wrapResult.innerHTML = `<a href="${link}" target="_blank" rel="noopener">${abs}</a> <button class="btn" onclick="w
indow.open('${link}','_blank')">Open</button>`;
      renderAudit();
    } catch (e) {
      wrapErr.textContent = (e && e.message) || 'Failed to generate';
    }
  }
  if (wrapBtn) wrapBtn.onclick = generateWrap;

  // Recent audit
  const auditEl = document.getElementById('auditList');
  async function renderAudit(){
    if (!auditEl) return;
    try {
      const j = await fetch('/audit?limit=10', { cache:'no-store' }).then(r => r.json());
      const items = Array.isArray(j.items) ? j.items : [];
      if (!items.length) { auditEl.textContent = '(none)'; return; }
      const rows = items.map(row => {
        const when = row.ts ? new Date(row.ts).toLocaleString() : '';
        const who = [row.eventId, row.attendee].filter(Boolean).join(' • ');
        return `<div>${when} • ${row.status} • ${who || '(anon)'} • ${row.ip || ''}</div>`;
      }).join('');
      auditEl.innerHTML = rows;
    } catch { auditEl.textContent = '(failed to load)'; }
  }
  const refreshAuditBtn = document.getElementById('refreshAudit');
  if (refreshAuditBtn) refreshAuditBtn.onclick = renderAudit;
  renderAudit();

})();
