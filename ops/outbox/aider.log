  res.on('finish', () => {
    const ms = Number((process.hrtime.bigint() - start) / 1000000n);
    const pathShown = req.originalUrl || req.url || '';
    try {
      console.log(`${req.method} ${pathShown} -> ${res.statusCode} ${ms}ms`);
    } catch {
